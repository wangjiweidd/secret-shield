{\n  "name": "secret-shield",\n  "displayName": "Secret Shield",\n  "description": "A VS Code extension for managing secrets and configurations securely.",\n  "version": "0.0.1",\n  "publisher": "wangjiweidd",\n  "engines": {\n    "vscode": "^1.60.0"\n  },\n  "categories": [\n    "Other"\n  ],\n  "activationEvents": [\n    "onCommand:secret-shield.someCommand"\n  ],\n  "main": "./out/extension.js",\n  "contributes": {\n    "commands": [\n      {\n        "command": "secret-shield.someCommand",\n        "title": "Run Some Command"\n      }\n    ]\n  },\n  "scripts": {\n    "vscode:prepublish": "tsc -p ./",\n    "compile": "tsc -watch -p ./",\n    "lint": "eslint ."\n  },\n  "devDependencies": {\n    "typescript": "^4.4.3",\n    "eslint": "^7.32.0",\n    "vscode": "^1.60.0",\n    "mocha": "^9.1.3"\n  }\n}